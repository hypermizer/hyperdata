[Unit]
Description=Independent Hyperdata runtime availability monitor
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hyperdata-external-watchdog
StateDirectory=hyperdata-health
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hyperdata-health
CapabilityBoundingSet=
MemoryMax=96M
