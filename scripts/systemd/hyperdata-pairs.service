[Unit]
Description=Hyperdata pair position monitoring, archived history and ntfy alerts
After=network-online.target hyperdata-data.service
Requires=hyperdata-data.service
[Service]
User=hyperdata-core
Group=hyperdata-data
WorkingDirectory=/opt/hyperdata-runtime/current
EnvironmentFile=/etc/hyperdata/core.env
EnvironmentFile=/etc/hyperdata/ntfy.env
EnvironmentFile=/etc/hyperdata/oxarchive.env
Environment=DENO_DIR=/opt/hyperdata-runtime/cache
ExecStart=/usr/local/bin/deno run --cached-only --frozen --config supabase/functions/deno.json --allow-env --allow-net=unix:/run/hyperdata-data/rest.sock,api.hyperliquid.xyz:443,api.0xarchive.io:443,ntfy.sh:443 --allow-read=/opt/hyperdata-runtime,/run/hyperdata-data --allow-write=/run/hyperdata-data runtime/pair-worker.ts
Restart=always
RestartSec=3
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=384M
TasksMax=48
LimitCORE=0
[Install]
WantedBy=multi-user.target
