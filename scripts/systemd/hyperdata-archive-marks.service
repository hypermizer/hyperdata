[Unit]
Description=Hyperdata genuine historical mark recovery for all markets
Requires=hyperdata-data.service
After=hyperdata-data.service network-online.target
[Service]
User=hyperdata-archive
Group=hyperdata-data
WorkingDirectory=/opt/hyperdata-runtime/current
EnvironmentFile=/etc/hyperdata/archive-marks.env
EnvironmentFile=/etc/hyperdata/oxarchive.env
Environment=DENO_DIR=/opt/hyperdata-runtime/cache
ExecStart=/usr/local/bin/deno run --cached-only --frozen --config supabase/functions/deno.json --allow-env --allow-net=unix:/run/hyperdata-data/rest.sock,api.0xarchive.io:443 --allow-read=/opt/hyperdata-runtime,/run/hyperdata-data --allow-write=/run/hyperdata-data runtime/archive-mark-history.ts
Restart=always
RestartSec=3
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=384M
TasksMax=48
LimitCORE=0
[Install]
WantedBy=multi-user.target
