[Unit]
Description=Hyperdata certificate-authenticated alert API
After=postgresql@16-hyperdata.service
Requires=postgresql@16-hyperdata.service
RequiresMountsFor=/srv/hyperdata
StartLimitIntervalSec=0
[Service]
User=hyperdata-api
Group=www-data
SupplementaryGroups=hyperdata-db
WorkingDirectory=/opt/hyperdata-runtime/current
EnvironmentFile=/etc/hyperdata/api.env
Environment=DENO_DIR=/opt/hyperdata-runtime/cache
RuntimeDirectory=hyperdata-api
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/deno run --cached-only --frozen --config supabase/functions/deno.json --allow-env --allow-net=unix:/run/postgresql-hyperdata/.s.PGSQL.5545,unix:/run/hyperdata-api/api.sock --allow-read=/opt/hyperdata-runtime,/run/postgresql-hyperdata,/run/hyperdata-api --allow-write=/run/hyperdata-api,/run/postgresql-hyperdata runtime/api.ts
Restart=always
RestartSec=2
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/hyperdata-api
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=32
LimitCORE=0
[Install]
WantedBy=multi-user.target
