[Unit]
Description=Hyperdata local %i processor
Requires=hyperdata-data.service
After=hyperdata-data.service network-online.target
[Service]
User=hyperdata-core
Group=hyperdata-data
WorkingDirectory=/opt/hyperdata-runtime/current
EnvironmentFile=/etc/hyperdata/core.env
Environment=DENO_DIR=/opt/hyperdata-runtime/cache
ExecStart=/usr/local/bin/deno run --cached-only --frozen --config supabase/functions/deno.json --allow-env --allow-net=unix:/run/hyperdata-data/rest.sock,api.hyperliquid.xyz:443 --allow-read=/opt/hyperdata-runtime,/run/hyperdata-data --allow-write=/run/hyperdata-data runtime/core-worker.ts %i
TimeoutStopSec=110
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=48
LimitCORE=0
[Install]
WantedBy=multi-user.target
